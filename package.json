{
  "name": "theme-sky-blog-2",
  "type": "module",
  "version": "1.2.12",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "build": "tsc && vite build && theme-package && node scripts/prune-theme-package.mjs",
    "build-only": "tsc && vite build",
    "check": "pnpm test:coverage && pnpm verify:plugin-contracts && pnpm prettier:check && pnpm verify:theme-updates && pnpm lint",
    "check:release": "node scripts/check-release.mjs",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "prepare": "husky",
    "prettier": "prettier --write README.md 'docs/**/*.md' './**/*.{ts,js,cjs,mjs,css,json,yaml,yml,html}'",
    "prettier:check": "prettier --check README.md 'docs/**/*.md' 'templates/**/*.html' 'src/**/*.{ts,css}' 'scripts/**/*.{js,mjs}' '*.{ts,js,cjs,mjs,css,json,yaml,yml}' '.github/workflows/*.{yaml,yml}'",
    "check:runtime-version": "node scripts/check-runtime-version.mjs",
    "reload:theme": "node scripts/reload-theme.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "test": "node --import tsx --test scripts/*.test.mjs",
    "test:coverage": "node scripts/run-tests-with-coverage.mjs",
    "verify:package": "node scripts/verify-theme-package.mjs",
    "verify:plugin-contracts": "node scripts/plugin-contracts.mjs",
    "verify:theme-updates": "node scripts/verify-theme-updates.mjs"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs,css,json,yaml,yml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "alpinejs": "^3.17.4",
    "figlet": "^1.11.4",
    "lozad": "^1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@halo-dev/theme-package-cli": "^1.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/alpinejs": "^3.13.11",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
