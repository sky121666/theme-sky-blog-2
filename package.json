{
  "name": "theme-sky-blog-2",
  "type": "module",
  "version": "1.2.1",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.6.5 <11"
  },
  "scripts": {
    "build": "tsc && vite build && theme-package && node scripts/prune-theme-package.mjs",
    "build-only": "tsc && vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "prepare": "husky",
    "prettier": "prettier --write './**/*.{ts,js,cjs,mjs,css,json,yaml,yml,html}'",
    "check:runtime-version": "node scripts/check-runtime-version.mjs",
    "reload:theme": "node scripts/reload-theme.mjs",
    "verify:package": "node scripts/verify-theme-package.mjs",
    "verify:theme-updates": "node scripts/verify-theme-updates.mjs"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs,css,json,yaml,yml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "alpinejs": "^3.15.12",
    "figlet": "^1.11.0",
    "lozad": "^1.16.0",
    "pjax": "^0.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@halo-dev/theme-package-cli": "^1.0.4",
    "@iconify-json/tabler": "^1.2.35",
    "@iconify/tailwind": "^1.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/alpinejs": "^3.13.11",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.5",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "packageManager": "pnpm@10.6.5+sha512.cdf928fca20832cd59ec53826492b7dc25dc524d4370b6b4adbf65803d32efaa6c1c88147c0ae4e8d579a6c9eec715757b50d4fa35eea179d868eada4ed043af"
}
